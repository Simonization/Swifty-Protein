# Copy to .env and adjust for your machine.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time (Expo convention) —
# fine here since it's just a base URL, not a secret.
#
# - iOS Simulator / Android Emulator: localhost usually works (Android emulator
#   also maps 10.0.2.2 -> host machine if localhost doesn't resolve).
# - Physical device: use your machine's LAN IP, e.g. http://192.168.1.20:3000
#   (must be on the same network as the backend; see `make up` in the repo root).
EXPO_PUBLIC_API_URL=http://localhost:3000
