# Copy to .env for local development: `npm run dev` loads it (via Node's
# --env-file-if-exists), and runs fine without it on the defaults below.
#
# `npm start` and the Docker image do NOT read this file — Compose passes the
# environment in directly (see docker-compose.yml), which is why the container
# does not need a .env at all.
PORT=3000
HOST=0.0.0.0

# REQUIRED in production — sign JWTs with a long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me

# How long an issued token stays valid (any ms/vercel duration string).
JWT_TTL=7d

# Postgres connection. When set, accounts are stored in Postgres; when unset
# (local dev / tests) the backend falls back to an in-memory store.
#
# NOTE: the `db` hostname only resolves *inside* Compose. Running `npm run dev`
# on your machine with this line uncommented will fail to connect — leave it
# commented out for local development and let the in-memory store take over.
# DATABASE_URL=postgres://protein:protein@db:5432/protein
